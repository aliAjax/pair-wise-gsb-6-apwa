{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "outDir": "./.test-build",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts"],
  "exclude": ["node_modules"]
}
